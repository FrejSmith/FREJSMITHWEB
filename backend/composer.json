{
    "name": "frejsmithweb/frejsmithweb",
    "description": "Site professionnel FrejSmithWeb avec PHP/Symfony",
    "type": "project",
    "require": {
        "php": "^8.0",
        "symfony/console": "^6.0",
        "symfony/dotenv": "^6.0",
        "symfony/framework-bundle": "^6.0",
        "symfony/orm-pack": "^2.0",
        "symfony/twig-bundle": "^6.0"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public",
        "db:migrate": "php bin/console doctrine:migrations:migrate"
    }
}
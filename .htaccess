# Sécurité - Bloquer l'accès aux fichiers sensibles
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquer l'accès aux dossiers sensibles
RedirectMatch 404 /\.git
RedirectMatch 404 /vendor/
RedirectMatch 404 /src/
RedirectMatch 404 /database/

# Protection contre les attaques XSS et injection
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;"
</IfModule>

# Limiter la taille des requêtes
LimitRequestBody 10485760

# Protection contre les attaques par déni de service
<IfModule mod_evasive24.c>
    DOSHashTableSize 100
    DOSPageCount 5
    DOSPageInterval 1
    DOSSiteCount 50
    DOSSiteInterval 1
    DOSBlockingPeriod 600
</IfModule>

# Bloquer les user agents suspects
<RequireAll>
    Require all granted
    <RequireNone>
        Require expr "%{HTTP_USER_AGENT} =~ /libwww-perl/"
        Require expr "%{HTTP_USER_AGENT} =~ /BBBike/"
        Require expr "%{HTTP_USER_AGENT} =~ /wget/"
        Require expr "%{HTTP_USER_AGENT} =~ /winhttp/"
        Require expr "%{HTTP_USER_AGENT} =~ /HTTrack/"
        Require expr "%{HTTP_USER_AGENT} =~ /clshttp/"
        Require expr "%{HTTP_USER_AGENT} =~ /archiver/"
        Require expr "%{HTTP_USER_AGENT} =~ /loader/"
        Require expr "%{HTTP_USER_AGENT} =~ /email/"
        Require expr "%{HTTP_USER_AGENT} =~ /harvest/"
        Require expr "%{HTTP_USER_AGENT} =~ /extract/"
        Require expr "%{HTTP_USER_AGENT} =~ /grab/"
        Require expr "%{HTTP_USER_AGENT} =~ /miner/"
        Require expr "%{HTTP_USER_AGENT} =~ /python-requests/"
        Require expr "%{HTTP_USER_AGENT} =~ /Go-http-client/"
        Require expr "%{HTTP_USER_AGENT} =~ /java/"
        Require expr "%{HTTP_USER_AGENT} =~ /okhttp/"
        Require expr "%{HTTP_USER_AGENT} =~ /scrapy/"
    </RequireNone>
</RequireAll>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Rediriger les requêtes vers index.html si le fichier n'existe pas
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.html [L]

    # Autoriser l'accès aux fichiers statiques
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Protection contre les attaques par injection SQL dans l'URL
    RewriteCond %{QUERY_STRING} (\'|%27|union|select|insert|cast|declare|drop|update|md5|benchmark|script|javascript|vbscript|onload|onerror) [NC]
    RewriteRule ^(.*)$ - [F,L]

    # Protection contre les traversées de répertoire
    RewriteCond %{REQUEST_URI} \.\./ [OR]
    RewriteCond %{REQUEST_URI} \\../ [OR]
    RewriteCond %{REQUEST_URI} ^.*\.(asp|exe|pl|cgi|scr|php|jsp)$ [NC]
    RewriteRule ^(.*)$ - [F,L]

    # Bloquer les accès directs aux fichiers PHP dans certains dossiers
    RewriteRule ^(src|vendor|database)/ - [F,L]

    # Forcer HTTPS (décommentez si vous avez un certificat SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Configuration PHP pour la sécurité
<IfModule mod_php.c>
    php_value upload_max_filesize 2M
    php_value post_max_size 8M
    php_value max_execution_time 30
    php_value max_input_time 30
    php_value memory_limit 128M
    php_flag display_errors off
    php_flag log_errors on
    php_value error_log /dev/null
</IfModule>
